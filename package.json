{
  "name": "ludics",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun build --compile src/index.ts --outfile bin/ludics",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "dev": "bun run src/index.ts",
    "lint": "node node_modules/eslint/bin/eslint.js \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "node node_modules/eslint/bin/eslint.js \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "typescript-eslint": "^8.26.0",
    "typescript": "^5.7"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
